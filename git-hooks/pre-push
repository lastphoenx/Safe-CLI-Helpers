#!/usr/bin/env bash
# pre-push: scannt ausgehende Commits mit Gitleaks (falls installiert).

set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  exit 0
fi

echo "🔒 Gitleaks pre-push scan..."
remote="${1:-origin}"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if ! gitleaks detect --log-opts="$range" --redact --verbose 2>&1; then
    echo "ABBRUCH: Gitleaks hat Secrets in ausgehenden Commits gefunden." >&2
    exit 1
  fi
done

exit 0
