#!/usr/bin/env bash
# pre-commit: nur staged Diff-Zeilen prüfen (schnell, kein Vollscan).

set -eu

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
RED='\033[0;31m'
YEL='\033[0;33m'
NC='\033[0m'
DENY_PATTERNS=()
ALLOW_PATTERNS=()

# shellcheck source=scan-lib.sh
. "${HOOK_DIR}/scan-lib.sh"

shopt -s nocasematch
load_scan_patterns

names="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)"
_check_risky_filenames "$names" || exit 1

diff="$(git diff --cached -U0 --no-color --no-ext-diff 2>/dev/null || true)"
if [ -n "$diff" ]; then
  if ! scan_unified_diff "$diff"; then
    echo "" >&2
    echo -e "${YEL}Commit abgebrochen.${NC} Private Daten entfernen oder Platzhalter nutzen (allowlist.txt / denylist.txt lokal)." >&2
    exit 1
  fi
fi

shopt -u nocasematch
exit 0
